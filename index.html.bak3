    <!-- ─── CURSOR DOT ─── -->
    <div id="cursor-dot" aria-hidden="true"></div>

    <!-- ─── BACK TO TOP ─── -->
    <button id="back-to-top" aria-label="Back to top" title="Back to top">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="18 15 12 9 6 15"/>
      </svg>
    </button>

    <script src="script.js?v=26"></script>

    

    <!-- ─── CASE STUDY OVERLAY LOGIC ─── -->
    <script>
    (() => {
      const caseStudies = {
        erp: {
          tag: 'Custom Financial Ecosystem',
          title: 'Head of FP&A for an aviation start-up',
          heroSvg: `<svg class="project-svg cs-hero-svg" viewBox="0 0 360 160" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Diagram: FP&amp;A work for an aviation start-up. Invoices, vendor contracts and fuel and macroeconomic data feed three things that were built: an invoice OCR tool, the financial model and a liquidity engine. Together they produce the forecast and cash plan, integrated with the existing platforms."><rect width="360" height="160" rx="8" fill="var(--ct-paper)"/><rect x="0.5" y="0.5" width="359" height="159" rx="7.5" fill="none" stroke="var(--ct-rule)"/><rect class="ct-tab" x="14" y="11" width="19" height="2.6"/><text class="ct-title" x="14" y="27">What we built</text><text class="ct-sub" x="14" y="38">FP&amp;A for an aviation start-up</text><g class="svg-fade" style="--d:.15s"><rect x="14" y="50" width="92" height="22" rx="4" fill="var(--ct-paper)" stroke="var(--ct-rule)"/><text class="ct-lbl" x="60.0" y="64.0" text-anchor="middle" fill="var(--ct-ink)">Invoices</text><rect x="14" y="80" width="92" height="22" rx="4" fill="var(--ct-paper)" stroke="var(--ct-rule)"/><text class="ct-lbl" x="60.0" y="94.0" text-anchor="middle" fill="var(--ct-ink)">Vendor contracts</text><rect x="14" y="110" width="92" height="22" rx="4" fill="var(--ct-paper)" stroke="var(--ct-rule)"/><text class="ct-lbl" x="60.0" y="124.0" text-anchor="middle" fill="var(--ct-ink)">Fuel &amp; macro data</text></g><g class="svg-fade" style="--d:.45s"><line class="ct-connector" x1="106" y1="61" x2="128" y2="61"/><circle cx="128" cy="61" r="1.8" fill="var(--ct-s4)"/><line class="ct-connector" x1="106" y1="91" x2="128" y2="91"/><circle cx="128" cy="91" r="1.8" fill="var(--ct-s4)"/><line class="ct-connector" x1="106" y1="121" x2="128" y2="121"/><circle cx="128" cy="121" r="1.8" fill="var(--ct-s4)"/><rect x="130" y="50" width="100" height="22" rx="4" fill="var(--ct-paper)" stroke="var(--ct-rule)"/><text class="ct-lbl" x="180.0" y="64.0" text-anchor="middle" fill="var(--ct-ink)">Invoice OCR</text><rect x="130" y="80" width="100" height="22" rx="4" fill="var(--ct-paper)" stroke="var(--ct-rule)"/><text class="ct-lbl" x="180.0" y="94.0" text-anchor="middle" fill="var(--ct-ink)">Financial model</text><rect x="130" y="110" width="100" height="22" rx="4" fill="var(--ct-paper)" stroke="var(--ct-rule)"/><text class="ct-lbl" x="180.0" y="124.0" text-anchor="middle" fill="var(--ct-ink)">Liquidity engine</text></g><g class="svg-fade" style="--d:.8s"><line class="ct-connector" x1="230" y1="61" x2="250" y2="86"/><circle cx="250" cy="86" r="1.8" fill="var(--ct-s4)"/><line class="ct-connector" x1="230" y1="91" x2="250" y2="91"/><circle cx="250" cy="91" r="1.8" fill="var(--ct-s4)"/><line class="ct-connector" x1="230" y1="121" x2="250" y2="96"/><circle cx="250" cy="96" r="1.8" fill="var(--ct-s4)"/><rect x="252" y="72" width="94" height="38" rx="4" fill="var(--ct-s1)" stroke="var(--ct-s1)"/><text class="ct-lbl" x="299.0" y="94.0" text-anchor="middle" style="fill:#ffffff;font-weight:700">Forecast &amp; cash plan</text><text class="ct-src" x="299" y="126" text-anchor="middle">on existing platforms</text></g></svg>`,
          company: 'An aviation start-up where PMG Services runs the FP&A function: financial modelling, vendor contract analysis and forecasting.',
          goal: 'Give the business a financial model and forecast it can rely on, and take manual work out of invoice processing and cash planning.',
          approach: [
            'Built and maintain the financial model',
            'Analysed vendor contracts',
            'Forecast macroeconomic inputs such as fuel prices using SQL and machine learning',
            'Built an invoice OCR tool, integrated with the existing platforms',
            'Built a liquidity engine for cash planning, integrated with the existing platforms'
          ],
          results: [],
          tech: ['SQL', 'Machine learning'],
          de: {
            tag: 'Individuelles Finanz-Ökosystem',
            title: 'Head of FP&A für ein Luftfahrt-Start-up',
            company: 'Ein Luftfahrt-Start-up, bei dem PMG Services die FP&A-Funktion übernimmt: Finanzmodellierung, Analyse von Lieferantenverträgen und Prognosen.',
            goal: 'Dem Unternehmen ein Finanzmodell und eine Prognose geben, auf die es sich verlassen kann, und manuelle Arbeit bei Rechnungsverarbeitung und Liquiditätsplanung reduzieren.',
            approach: [
              'Finanzmodell aufgebaut und laufend gepflegt',
              'Lieferantenverträge analysiert',
              'Makroökonomische Größen wie Treibstoffpreise mit SQL und Machine Learning prognostiziert',
              'Ein Invoice-OCR-Tool gebaut und in die bestehenden Plattformen integriert',
              'Eine Liquiditäts-Engine für die Cash-Planung gebaut und in die bestehenden Plattformen integriert'
            ],
            results: []
          }
        },
        forecasting: {
          tag: 'Integrated Planning',
          title: 'End-to-end Anaplan implementation for a global healthcare company',
          heroSvg: `<svg class="project-svg cs-hero-svg" viewBox="0 0 360 160" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Diagram: an end-to-end Anaplan implementation for a global healthcare company. Sales planning and financial planning, previously separate cycles, feed one driver-based model, which produces the financial forecast and the reporting package."><rect width="360" height="160" rx="8" fill="var(--ct-paper)"/><rect x="0.5" y="0.5" width="359" height="159" rx="7.5" fill="none" stroke="var(--ct-rule)"/><rect class="ct-tab" x="14" y="11" width="19" height="2.6"/><text class="ct-title" x="14" y="27">Two planning cycles, one model</text><text class="ct-sub" x="14" y="38">Anaplan, global healthcare company</text><g class="svg-fade" style="--d:.15s"><rect x="14" y="58" width="96" height="24" rx="4" fill="var(--ct-paper)" stroke="var(--ct-rule)"/><text class="ct-lbl" x="62.0" y="73.0" text-anchor="middle" fill="var(--ct-ink)">Sales planning</text><rect x="14" y="98" width="96" height="24" rx="4" fill="var(--ct-paper)" stroke="var(--ct-rule)"/><text class="ct-lbl" x="62.0" y="113.0" text-anchor="middle" fill="var(--ct-ink)">Financial planning</text></g><g class="svg-fade" style="--d:.45s"><line class="ct-connector" x1="110" y1="70" x2="132" y2="82"/><circle cx="132" cy="82" r="1.8" fill="var(--ct-s4)"/><line class="ct-connector" x1="110" y1="110" x2="132" y2="98"/><circle cx="132" cy="98" r="1.8" fill="var(--ct-s4)"/><rect x="134" y="66" width="100" height="48" rx="4" fill="var(--ct-s1)" stroke="var(--ct-s1)"/><text class="ct-lbl" x="184.0" y="93.0" text-anchor="middle" style="fill:#ffffff;font-weight:700">Driver-based model</text><text class="ct-src" x="184" y="126" text-anchor="middle">Anaplan</text></g><g class="svg-fade" style="--d:.8s"><line class="ct-connector" x1="234" y1="82" x2="256" y2="70"/><circle cx="256" cy="70" r="1.8" fill="var(--ct-s4)"/><line class="ct-connector" x1="234" y1="98" x2="256" y2="110"/><circle cx="256" cy="110" r="1.8" fill="var(--ct-s4)"/><rect x="258" y="58" width="88" height="24" rx="4" fill="var(--ct-paper)" stroke="var(--ct-rule)"/><text class="ct-lbl" x="302.0" y="73.0" text-anchor="middle" fill="var(--ct-ink)">Financial forecast</text><rect x="258" y="98" width="88" height="24" rx="4" fill="var(--ct-paper)" stroke="var(--ct-rule)"/><text class="ct-lbl" x="302.0" y="113.0" text-anchor="middle" fill="var(--ct-ink)">Reporting package</text></g></svg>`,
          company: 'A large global healthcare company whose sales planning and financial planning ran as separate cycles.',
          goal: 'Bring sales and financial planning together in one model, so changes in sales flow straight into the financial forecast.',
          approach: [
            'Owned the project end to end, from requirements and solution design to model build',
            'Designed one embedded driver-based model covering both planning cycles',
            'Linked sales inputs directly to the financial forecast',
            'Built the reporting package'
          ],
          results: [],
          tech: ['Anaplan'],
          de: {
            tag: 'Integrierte Planung',
            title: 'End-to-End-Anaplan-Implementierung für ein globales Healthcare-Unternehmen',
            company: 'Ein großes globales Healthcare-Unternehmen, dessen Vertriebsplanung und Finanzplanung als getrennte Zyklen liefen.',
            goal: 'Vertriebs- und Finanzplanung in einem Modell zusammenführen, damit Änderungen im Vertrieb direkt in die Finanzprognose einfließen.',
            approach: [
              'Projekt von Anfang bis Ende verantwortet, von Anforderungen und Lösungsdesign bis zum Modellaufbau',
              'Ein eingebettetes, treiberbasiertes Modell für beide Planungszyklen entworfen',
              'Vertriebsinputs direkt mit der Finanzprognose verknüpft',
              'Das Reporting-Paket aufgebaut'
            ],
            results: []
          }
        }
      };

      function getActiveLang() {
        const active = document.querySelector('.lang-link.active');
        return active && active.textContent.trim().toLowerCase() === 'de' ? 'de' : 'en';
      }

      function renderCaseStudy(key) {
        const cs = caseStudies[key];
        if (!cs) return;
        const lang = getActiveLang();
        const isDe = lang === 'de' && cs.de;
        const tag = isDe ? cs.de.tag : cs.tag;
        const title = isDe ? cs.de.title : cs.title;
        const company = isDe ? cs.de.company : cs.company;
        const goal = isDe ? cs.de.goal : cs.goal;
        const approach = isDe ? cs.de.approach : cs.approach;
        const results = isDe ? cs.de.results : cs.results;
        const sectionLabels = isDe
          ? { company: 'Unternehmen', goal: 'Ziel', approach: 'Unser Ansatz', results: 'Ergebnisse', tech: 'Technologie-Stack' }
          : { company: 'Company', goal: 'Goal', approach: 'Our Approach', results: 'Results', tech: 'Technology Stack' };

        const resultsHtml = results.map(r => `<div class="cs-result-item"><span class="cs-result-value">${r.value}</span><span class="cs-result-label">${r.label}</span></div>`).join('');
        const approachHtml = approach.map(a => `<li>${a}</li>`).join('');
        const techHtml = cs.tech.map(t => `<span class="cs-tech-tag">${t}</span>`).join('');

        document.getElementById('cs-content').innerHTML = `
          <div class="cs-tag-line"><span class="cs-tag">${tag}</span></div>
          <h2 class="cs-title" id="cs-dialog-title">${title}</h2>
          <div class="cs-hero-visual">${cs.heroSvg}</div>
          <div class="cs-two-col">
            <div class="cs-section"><h2 class="cs-section-title">${sectionLabels.company}</h2><p class="cs-section-text">${company}</p></div>
            <div class="cs-section"><h2 class="cs-section-title">${sectionLabels.goal}</h2><p class="cs-section-text">${goal}</p></div>
          </div>
          <div class="cs-section"><h2 class="cs-section-title">${sectionLabels.approach}</h2><ul class="cs-approach-list">${approachHtml}</ul></div>
          ${results.length ? `<div class="cs-section cs-results-section"><h2 class="cs-section-title">${sectionLabels.results}</h2><div class="cs-results-grid">${resultsHtml}</div></div>` : ''}
          <div class="cs-section"><h2 class="cs-section-title">${sectionLabels.tech}</h2><div class="cs-tech-list">${techHtml}</div></div>
        `;
      }

      document.querySelectorAll('.project-cta[data-case]').forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          renderCaseStudy(link.getAttribute('data-case'));
          const overlay = document.getElementById('case-study-overlay');
          overlay.classList.add('active');
          document.body.style.overflow = 'hidden';
          overlay.querySelector('.cs-panel').scrollTop = 0;
        });
      });

      document.getElementById('cs-back-btn').addEventListener('click', () => {
        document.getElementById('case-study-overlay').classList.remove('active');
        document.body.style.overflow = '';
      });

      document.getElementById('case-study-overlay').addEventListener('click', (e) => {
        if (e.target === e.currentTarget) {
          e.currentTarget.classList.remove('active');
          document.body.style.overflow = '';
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          document.getElementById('case-study-overlay').classList.remove('active');
          document.body.style.overflow = '';
        }
      });
    })();
    </script>

  </body>
</html>
