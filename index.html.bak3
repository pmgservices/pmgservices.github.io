              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <path d="M9 9h6M9 13h6M9 17h4"/>
              </svg>
            </div>
          </div>
          <h3 class="hww-title">Design</h3>
          <p class="hww-desc">We design the solution, from the process rules to the technical setup. Every part of it is tied to something you can measure, and we agree the scope before anyone starts building.</p>
          <ul class="hww-bullets">
            <li>Solution architecture</li>
            <li>KPI &amp; success metrics</li>
            <li>Implementation roadmap</li>
            <li>Risk &amp; change management</li>
          </ul>
        </div>

        <div class="hww-connector" aria-hidden="true"></div>

        <div class="hww-step" style="transition-delay: 0.3s">
          <div class="hww-step-head">
            <span class="hww-num">03</span>
            <div class="hww-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 11 12 14 22 4"/>
                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
